{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.onyou.studio/garment-project.schema.json",
  "title": "On You Studio project revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revisionId", "parentRevisionId", "name", "category", "createdAt", "updatedAt", "producer", "currentGarmentRevisionId", "selectedFitModelRevisionId", "previewView", "validationStatus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "revisionId": { "type": "string", "format": "uuid" },
    "parentRevisionId": { "type": ["string", "null"], "format": "uuid" },
    "importedFrom": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "projectRevisionId"],
      "properties": {
        "projectId": { "type": "string", "format": "uuid" },
        "projectRevisionId": { "type": "string", "format": "uuid" }
      }
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "const": "tshirt" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "currentGarmentRevisionId": { "type": "string", "format": "uuid" },
    "selectedFitModelRevisionId": { "type": "string", "format": "uuid" },
    "previewView": { "enum": ["split", "2d", "3d"] },
    "validationStatus": { "const": "illustrative" }
  }
}
