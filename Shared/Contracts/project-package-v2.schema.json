{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "https://schemas.onyou.studio/project-package-v2.schema.json",
  "title": "On You Studio self-contained v2 project package", "type": "object", "additionalProperties": false,
  "required": ["format", "schemaVersion", "packagedAt", "project", "revisions", "template", "fitModels", "meshAssets", "assets", "previewStatus", "limitations"],
  "properties": {
    "format": { "const": "onyou-project" }, "schemaVersion": { "const": 2 }, "packagedAt": { "type": "string", "format": "date-time" },
    "project": { "$ref": "garment-project-v2.schema.json" },
    "revisions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "oneOf": [{ "$ref": "garment-revision.schema.json" }, { "$ref": "garment-revision-v2.schema.json" }] } },
    "template": { "$ref": "garment-template.schema.json" },
    "fitModels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "fit-model-revision.schema.json" } },
    "meshAssets": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "mesh-asset-descriptor.schema.json" } },
    "assets": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "project-package-v1.schema.json#/definitions/asset" } },
    "previewStatus": { "const": "illustrative" },
    "limitations": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  }
}
