{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Itchathon",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "FitCheck": {
      "deploymentTarget": "26.0",
      "info": {
        "path": "Sources/Support/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Itchathon",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "NSCameraUsageDescription": "Itchathon uses the camera and depth sensors for guided body capture and clothing tools. Camera views are processed on your iPhone."
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.0bab6520-e754-44f9-acd8-d1ecceeda6e3",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.10",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "Sources",
          "excludes": [
            "Support/Info.plist"
          ]
        }
      ],
      "type": "application",
      "postBuildScripts": [
        {
          "name": "Stage internal mesh only in Debug",
          "basedOnDependencyAnalysis": false,
          "showEnvVars": false,
          "inputFiles": [
            "$(SRCROOT)/DevelopmentAssets/FitCheckGeometricVest.fitmesh",
            "$(SRCROOT)/DevelopmentAssets/HumanShowcase/human-showcase-v1.bin",
            "$(SRCROOT)/DevelopmentAssets/HumanShowcase/LICENSE.txt",
            "$(SRCROOT)/DevelopmentAssets/HumanShowcase/NOTICE.txt"
          ],
          "outputFiles": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/FitCheckDevelopmentAssets",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/HumanShowcase"
          ],
          "script": "set -eu\ndestination=\"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}\"\nlegacy=\"${destination}/FitCheckDevelopmentAssets\"\nshowcase=\"${destination}/HumanShowcase\"\nif [ \"${CONFIGURATION}\" = \"Debug\" ]; then\n  /bin/mkdir -p \"${legacy}\"\n  /bin/cp -f \"${SRCROOT}/DevelopmentAssets/FitCheckGeometricVest.fitmesh\" \"${legacy}/FitCheckGeometricVest.fitmesh\"\n  /bin/rm -rf \"${showcase}\"\n  /bin/cp -R \"${SRCROOT}/DevelopmentAssets/HumanShowcase\" \"${showcase}\"\nelse\n  # Remove only this build phase's own generated resources, never unrelated resources.\n  /bin/rm -f \"${legacy}/FitCheckGeometricVest.fitmesh\"\n  if [ -d \"${legacy}\" ]; then\n    /bin/rmdir \"${legacy}\"\n  fi\n  /bin/rm -rf \"${showcase}\"\nfi\n"
        }
      ]
    },
    "FitCheckTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": [
        {
          "path": "Tests"
        }
      ],
      "dependencies": [
        {
          "target": "FitCheck"
        }
      ],
      "settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "CODE_SIGNING_ALLOWED": "NO"
      }
    },
    "FitCheckUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        {
          "path": "UITests"
        }
      ],
      "dependencies": [
        {
          "target": "FitCheck"
        }
      ],
      "settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "CODE_SIGNING_ALLOWED": "NO"
      }
    }
  },
  "schemes": {
    "FitCheck": {
      "build": {
        "targets": {
          "FitCheck": "all",
          "FitCheckTests": [
            "test"
          ],
          "FitCheckUITests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "FitCheckTests",
          "FitCheckUITests"
        ]
      }
    }
  }
}
